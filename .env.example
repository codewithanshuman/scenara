# Local API
SCENARA_PORT=8787
SCENARA_PUBLIC_ORIGIN=http://127.0.0.1:5173
SCENARA_DATA_PATH=./data/scenara.db.json

# Required on Vercel. A Neon integration normally injects DATABASE_URL.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Cloudinary server-only secrets
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret
CLOUDINARY_UPLOAD_FOLDER=scenara
CLOUDINARY_NOTIFICATION_URL=
